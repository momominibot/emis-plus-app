{
  "expo": {
    "name": "EMIS+",
    "slug": "emis-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "emisapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "asia.emis.app",
      "usesAppleSignIn": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Used to scan QR codes for local device-to-device data transfer",
        "NSPhotoLibraryUsageDescription": "Used to attach photos to wound records",
        "NSHealthShareUsageDescription": "Not used - all health data stays local",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "asia.emis.app",
      "adaptiveIcon": {
        "backgroundColor": "#0d9488",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#0d9488"
        }
      ],
      "expo-sqlite",
      "expo-sharing",
      "expo-secure-store",
      "expo-apple-authentication",
      "expo-image",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow EMIS+ to use your camera for QR code scanning and wound photos."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "baseUrl": "/emis-plus-app"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "a0a43dad-31a1-40be-b876-2834a48b68cc"
      }
    },
    "owner": "momomini"
  }
}
