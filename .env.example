# EMIS+ app configuration. Copy to .env (git-ignored) or set in EAS / CI.
# Only EXPO_PUBLIC_* values belong here: they are compiled into the app and
# visible to anyone. Never put a service-role key, database URL or Shopify
# Admin token in this file.

# Supabase project for EMIS+ accounts (ref pgwenyjjjabzkaztkphd).
# The publishable key is meant to be public; Row Level Security and the
# loyalty edge function decide what it can reach.
EXPO_PUBLIC_SUPABASE_URL=https://pgwenyjjjabzkaztkphd.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_EHzy5gDqVM9G6MITankWbg_LMul3QEY

# Sign-in methods to offer, comma separated: email, apple, google.
# List apple and google only once their Supabase providers are set up.
EXPO_PUBLIC_AUTH_PROVIDERS=email

# Health Points screens. The loyalty edge function is deployed; points arrive
# once Shopify webhooks are registered.
EXPO_PUBLIC_LOYALTY_ENABLED=true

# Optional: override the loyalty API (defaults to <SUPABASE_URL>/functions/v1/loyalty).
# EXPO_PUBLIC_LOYALTY_API_URL=
